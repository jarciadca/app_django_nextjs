# ============================================================
# PLANTILLA de variables de entorno. Copia este archivo a .env
# y rellena con valores reales. NUNCA subas el .env al repo.
# ============================================================

# --- Django ---
# Clave secreta para firmar sesiones/tokens. Genera una con:
#   python3 -c "from secrets import token_urlsafe; print(token_urlsafe(64))"
DJANGO_SECRET_KEY=reemplaza_esto_por_una_clave_larga_y_aleatoria
# Modo debug: True en local, False en producción
DJANGO_DEBUG=True
# Hosts permitidos separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Entorno lógico: local | production | test
DJANGO_ENV=local

# --- PostgreSQL ---
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=cambia_esto_por_algo_seguro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
# Minutos de vida del access token
JWT_ACCESS_MINUTES=15
# Días de vida del refresh token
JWT_REFRESH_DAYS=7

# --- Email (recuperación de contraseña) ---
# En local usamos consola; en producción SMTP real
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@app_django_nextjs.local

# --- Frontend ---
# URL base del backend para que Next.js la consuma
NEXT_PUBLIC_API_URL=http://localhost:8000/api
